    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  },
  "ingestionstream": {
    "key": "IngestionStream",
    "arn": "arn:${Partition}:aoss:${Region}:${Account}:collection/${CollectionId}/ingestion-stream/${IngestionStreamId}",
    "conditionKeys": [
