{
  "application": {
    "key": "application",
    "arn": "arn:${Partition}:kinesisanalytics:${Region}:${Account}:application/${ApplicationName}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  },
  "snapshot": {
    "key": "snapshot",
    "arn": "arn:${Partition}:kinesisanalytics:${Region}:${Account}:snapshot/${SnapshotName}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  }
}