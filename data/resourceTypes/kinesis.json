{
  "channel": {
    "key": "channel",
    "arn": "arn:${Partition}:kinesis:${Region}:${Account}:channel/${ChannelId}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  },
  "consumer": {
    "key": "consumer",
    "arn": "arn:${Partition}:kinesis:${Region}:${Account}:${StreamType}/${StreamName}/consumer/${ConsumerName}:${ConsumerCreationTimpstamp}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  },
  "kmskey": {
    "key": "kmsKey",
    "arn": "arn:${Partition}:kms:${Region}:${Account}:key/${KeyId}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  },
  "queue": {
    "key": "queue",
    "arn": "arn:${Partition}:kinesis:${Region}:${Account}:queue/${QueueId}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  },
  "stream": {
    "key": "stream",
    "arn": "arn:${Partition}:kinesis:${Region}:${Account}:stream/${StreamName}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  }
}